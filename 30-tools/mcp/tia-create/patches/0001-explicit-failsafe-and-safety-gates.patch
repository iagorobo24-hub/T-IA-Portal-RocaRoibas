diff --git a/tools/tiaportal-mcp/src/TiaMcpServer/Siemens/Portal.Safety.cs b/tools/tiaportal-mcp/src/TiaMcpServer/Siemens/Portal.Safety.cs
new file mode 100644
index 0000000000000000000000000000000000000000..07b67317c72dcf4141f72cd7b21a918460309c0c
--- /dev/null
+++ b/tools/tiaportal-mcp/src/TiaMcpServer/Siemens/Portal.Safety.cs
@@ -0,0 +1,90 @@
+using Siemens.Engineering;
+using Siemens.Engineering.HW;
+using Siemens.Engineering.HW.Features;
+using Siemens.Engineering.SW;
+using Siemens.Engineering.SW.Blocks;
+using Siemens.Engineering.SW.Tags;
+using Microsoft.Extensions.Logging;
+using System;
+using System.Collections.Generic;
+using System.Linq;
+
+namespace TiaMcpServer.Siemens
+{
+    public sealed class PlcTagSafetyInfo
+    {
+        public string Path { get; set; } = "";
+        public string Name { get; set; } = "";
+        public bool? IsSafety { get; set; }
+    }
+
+    public partial class Portal
+    {
+        public List<PlcTagSafetyInfo> GetPlcTags(string softwarePath)
+        {
+            if (IsProjectNull()) throw new PortalException(PortalErrorCode.InvalidState, "No project open; PLC tag classification is incomplete.");
+            var software = GetPlcSoftware(softwarePath);
+            if (software == null) throw new PortalException(PortalErrorCode.NotFound, $"PLC software not found: '{softwarePath}'.");
+            var root = software.TagTableGroup;
+            if (root == null) throw new PortalException(PortalErrorCode.InvalidState, $"PLC software '{softwarePath}' has no readable tag-table root.");
+            var result = new List<PlcTagSafetyInfo>();
+            CollectTags(root, "", result);
+            return result;
+        }
+
+        public void EnsureNoSafetyObjectsForDownload(string softwarePath)
+        {
+            if (IsProjectNull()) throw new PortalException(PortalErrorCode.InvalidState, "Download blocked: no valid TIA project is open for F/Safety preflight.");
+            var software = GetPlcSoftware(softwarePath);
+            if (software == null) throw new PortalException(PortalErrorCode.NotFound, $"Download blocked: PLC software not found at '{softwarePath}'.");
+            var blockRoot = software.BlockGroup;
+            if (blockRoot == null) throw new PortalException(PortalErrorCode.InvalidState, $"Download blocked: PLC '{softwarePath}' has no readable block root.");
+
+            var blocks = new List<PlcBlock>();
+            CollectBlocks(blockRoot, blocks);
+            if (blocks.Count == 0) throw new PortalException(PortalErrorCode.InvalidState, $"Download blocked: no PLC blocks were enumerated for '{softwarePath}'.");
+            foreach (var block in blocks)
+            {
+                var classification = SafetyClassification.GetFailsafeClassification(block);
+                if (classification != false)
+                {
+                    var state = classification == true ? "F/Safety" : "unknown";
+                    throw new PortalException(PortalErrorCode.InvalidState, $"Download blocked: block '{block.Name}' is classified as {state}.");
+                }
+                if (block.IsKnowHowProtected)
+                    throw new PortalException(PortalErrorCode.InvalidState, $"Download blocked: block '{block.Name}' has know-how protection.");
+            }
+
+            var tags = GetPlcTags(softwarePath);
+            foreach (var tag in tags)
+            {
+                if (tag.IsSafety != false)
+                {
+                    var state = tag.IsSafety == true ? "Safety" : "unknown";
+                    throw new PortalException(PortalErrorCode.InvalidState, $"Download blocked: tag '{tag.Path}' is classified as {state}.");
+                }
+            }
+
+            _logger?.LogInformation("F/Safety download preflight passed for {SoftwarePath}: {BlockCount} standard blocks, {TagCount} non-Safety tags.", softwarePath, blocks.Count, tags.Count);
+        }
+
+        private static void CollectBlocks(PlcBlockGroup group, List<PlcBlock> result)
+        {
+            foreach (var composition in group.Blocks)
+                if (composition is PlcBlock block) result.Add(block);
+            foreach (PlcBlockGroup child in group.Groups) CollectBlocks(child, result);
+        }
+
+        private static void CollectTags(PlcTagTableGroup group, string prefix, List<PlcTagSafetyInfo> result)
+        {
+            foreach (PlcTagTable table in group.TagTables)
+            {
+                var tablePath = string.IsNullOrEmpty(prefix) ? table.Name : prefix + "/" + table.Name;
+                foreach (PlcTag tag in table.Tags)
+                    result.Add(new PlcTagSafetyInfo { Path = tablePath + "/" + tag.Name, Name = tag.Name, IsSafety = tag.IsSafety });
+            }
+            foreach (PlcTagTableGroup child in group.Groups)
+                CollectTags(child, string.IsNullOrEmpty(prefix) ? child.Name : prefix + "/" + child.Name, result);
+        }
+    }
+}
