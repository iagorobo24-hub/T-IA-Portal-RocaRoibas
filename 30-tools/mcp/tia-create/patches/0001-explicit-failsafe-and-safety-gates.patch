new file mode 100644
index 0000000000000000000000000000000000000000..da7c2164357acad99efb70811a99c7350a16231f
--- /dev/null
+++ b/tools/tiaportal-mcp/src/TiaMcpServer/Siemens/SafetyClassification.cs
@@ -0,0 +1,20 @@
+using Siemens.Engineering.Safety;
+using Siemens.Engineering.SW.Blocks;
+using System;
+
+namespace TiaMcpServer.Siemens
+{
+    /// <summary>Fail-closed classification for PLC blocks used by the write/download gate.</summary>
+    public static class SafetyClassification
+    {
+        public static bool? GetFailsafeClassification(PlcBlock block)
+        {
+            if (block == null) return null;
+            var language = Enum.GetName(typeof(ProgrammingLanguage), block.ProgrammingLanguage);
+            if (string.IsNullOrWhiteSpace(language) || language == "Undef") return null;
+            if (language.StartsWith("F_", StringComparison.Ordinal)) return true;
+            try { return block.GetService<SafetySignatureProvider>() != null; }
+            catch { return null; }
+        }
+    }
+}
