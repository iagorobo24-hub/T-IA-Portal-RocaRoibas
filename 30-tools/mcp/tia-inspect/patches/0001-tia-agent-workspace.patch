+                        && backupFullPath.StartsWith(rootPrefix, StringComparison.OrdinalIgnoreCase)
+                        && !string.Equals(fullPath, backupFullPath, StringComparison.OrdinalIgnoreCase)
+                        && File.Exists(backupFullPath);
+                }
+            }
+            catch
+            {
+                return false;
+            }
+        }
 
         // Registry sub keys below 'TIAP{version}' that hold the installation path, most specific first.
         private static readonly string[] PreferredInstallPathSubKeys = { "TIA_Opns", "Global", "EditionMain" };
diff --git a/src/TiaMcpServer/Siemens/Portal.Safety.cs b/src/TiaMcpServer/Siemens/Portal.Safety.cs
new file mode 100644
index 0000000000000000000000000000000000000000..d2fb620538879efab492dc6bce7ccbf26993da4b
--- /dev/null
+++ b/src/TiaMcpServer/Siemens/Portal.Safety.cs
@@ -0,0 +1,188 @@
+using Siemens.Engineering;
+using Siemens.Engineering.HW;
+using Siemens.Engineering.HW.Features;
+using Siemens.Engineering.SW;
+using Siemens.Engineering.SW.Blocks;
+using Siemens.Engineering.SW.Tags;
+using Siemens.Engineering.SW.Types;
+using Microsoft.Extensions.Logging;
+using System;
+using System.Collections.Generic;
+using System.Linq;
+
+namespace TiaMcpServer.Siemens
+{
+    public partial class Portal
+    {
+        /// <summary>
+        /// Rejects every MCP project mutation if a PLC block cannot be proven standard or if
+        /// any PLC Safety tag is present. This intentionally protects indirect operations such
+        /// as imports, group deletes, block moves and type replacement with one shared preflight.
+        /// Callers must separately classify opaque incoming content before registering a tool.
+        /// </summary>
+        public void EnsureNoSafetyObjectsForWrite(string operation)
+        {
+            if (!ProjectIsValid)
+            {
+                throw new PortalException(PortalErrorCode.InvalidState,
+                    $"Cannot perform '{operation}': no valid project is open for the F/Safety preflight.");
+            }
+
+            var softwareItems = EnumeratePlcSoftware();
+            if (softwareItems.Count == 0)
+            {
+                throw new PortalException(PortalErrorCode.InvalidState,
+                    $"Cannot perform '{operation}': no PLC software was enumerated; the F/Safety scope cannot be proven complete.");
+            }
+
+            var blockCount = 0;
+            var tagCount = 0;
+
+            foreach (var software in softwareItems)
+            {
+                var blockRoot = software.BlockGroup;
+                if (blockRoot == null)
+                {
+                    throw new PortalException(PortalErrorCode.InvalidState,
+                        $"Cannot perform '{operation}': PLC software '{software.Name}' has no readable block root; safety classification is incomplete.");
+                }
+
+                var blocks = new List<PlcBlock>();
+                GetBlocksRecursive(blockRoot, blocks);
+                blockCount += blocks.Count;
+
+                foreach (var block in blocks)
+                {
+                    var classification = SafetyClassification.GetFailsafeClassification(block);
+                    if (classification != false)
+                    {
+                        var state = classification == true ? "F/Safety" : "unknown";
+                        throw new PortalException(PortalErrorCode.InvalidState,
+                            $"Cannot perform '{operation}': PLC block '{block.Name}' is classified as {state}; all project writes are blocked until the F/Safety scope is removed or explicitly handled outside this agent workflow.");
+                    }
+
+                    if (block.IsKnowHowProtected)
+                    {
+                        throw new PortalException(PortalErrorCode.InvalidState,
+                            $"Cannot perform '{operation}': PLC block '{block.Name}' has know-how protection; all project writes are blocked until protected scope is handled in TIA Portal.");
+                    }
+                }
+
+                var typeRoot = software.TypeGroup;
+                if (typeRoot == null)
+                {
+                    throw new PortalException(PortalErrorCode.InvalidState,
+                        $"Cannot perform '{operation}': PLC software '{software.Name}' has no readable type root; protected-type classification is incomplete.");
+                }
+
+                var types = new List<PlcType>();
+                WalkRecursive<PlcTypeGroup, PlcType>(
+                    typeRoot, types, group => group.Types, group => group.Groups,
+                    type => type.Name);
+
+                foreach (var type in types)
+                {
+                    if (type.IsKnowHowProtected)
+                    {
+                        throw new PortalException(PortalErrorCode.InvalidState,
+                            $"Cannot perform '{operation}': PLC type '{type.Name}' has know-how protection; all project writes are blocked until protected scope is handled in TIA Portal.");
+                    }
+                }
+
+                var tagRoot = software.TagTableGroup;
+                if (tagRoot == null)
+                {
+                    throw new PortalException(PortalErrorCode.InvalidState,
+                        $"Cannot perform '{operation}': PLC software '{software.Name}' has no readable tag-table root; Safety-tag classification is incomplete.");
+                }
+
+                var tables = new List<PlcTagTable>();
+                WalkRecursive<PlcTagTableGroup, PlcTagTable>(
+                    tagRoot, tables, group => group.TagTables, group => group.Groups,
+                    table => table.Name);
+
+                foreach (var table in tables)
+                {
+                    foreach (var tag in table.Tags)
+                    {
+                        tagCount++;
+                        if (tag.IsSafety)
+                        {
+                            throw new PortalException(PortalErrorCode.InvalidState,
+                                $"Cannot perform '{operation}': PLC tag '{table.Name}/{tag.Name}' is marked Safety; all project writes are blocked until the Safety-tag scope is removed or explicitly handled outside this agent workflow.");
+                        }
+                    }
+                }
+            }
+
+            _logger?.LogDebug(
+                "F/Safety preflight for {Operation} passed: {SoftwareCount} PLC software objects, {BlockCount} classified standard blocks, {TagCount} non-Safety PLC tags",
+                operation, softwareItems.Count, blockCount, tagCount);
+        }
+
+        private List<PlcSoftware> EnumeratePlcSoftware()
+        {
+            var software = new List<PlcSoftware>();
+
+            if (_project?.Devices != null)
+            {
+                foreach (Device device in _project.Devices)
+                {
+                    CollectPlcSoftware(device.DeviceItems, software);
+                }
+            }
+
+            if (_project?.DeviceGroups != null)
+            {
+                CollectPlcSoftware(_project.DeviceGroups, software);
+            }
+
+            if (_project?.UngroupedDevicesGroup?.Devices != null)
+            {
+                foreach (var composition in _project.UngroupedDevicesGroup.Devices)
+                {
+                    if (composition is Device device)
+                    {
+                        CollectPlcSoftware(device.DeviceItems, software);
+                    }
+                }
+            }
+
+            return software;
+        }
+
+        private void CollectPlcSoftware(DeviceUserGroupComposition groups, List<PlcSoftware> software)
+        {
+            foreach (DeviceUserGroup group in groups)
+            {
+                foreach (var composition in group.Devices)
+                {
+                    if (composition is Device device)
+                    {
+                        CollectPlcSoftware(device.DeviceItems, software);
+                    }
+                }
+
+                CollectPlcSoftware(group.Groups, software);
+            }
+        }
+
+        private void CollectPlcSoftware(DeviceItemComposition deviceItems, List<PlcSoftware> software)
+        {
+            foreach (DeviceItem item in deviceItems)
+            {
+                var container = item.GetService<SoftwareContainer>();
+                if (container?.Software is PlcSoftware plcSoftware &&
+                    !software.Any(existing => ReferenceEquals(existing, plcSoftware)))
+                {
+                    software.Add(plcSoftware);
+                }
+
+                if (item.DeviceItems != null && item.DeviceItems.Count > 0)
+                {
+                    CollectPlcSoftware(item.DeviceItems, software);
+                }
+            }
+        }
+    }
+}
