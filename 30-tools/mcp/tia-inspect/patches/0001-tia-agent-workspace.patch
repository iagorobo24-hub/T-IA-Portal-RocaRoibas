+        /// <summary>
+        /// Deja pasar los valores simples y convierte a texto cualquier otra cosa.
+        ///
+        /// Algunos atributos de Openness devuelven objetos del modelo (DirectoryInfo, CultureInfo,
+        /// MultilingualText...) cuyo grafo tiene ciclos Parent/Root. Serializarlos tal cual hacia
+        /// que System.Text.Json abortara con "A possible object cycle was detected" y la herramienta
+        /// entera fallara: le pasaba a GetProject, GetDevices, GetDeviceInfo y GetDeviceItemInfo.
+        ///
+        /// Es el mismo criterio que ya aplica ResponseConstantInfo.Value, que se stringifica a
+        /// proposito para que el esquema de salida sea estable.
+        ///
+        /// Los tipos simples se conservan con su tipo JSON original, asi que la salida de los
+        /// atributos que ya funcionaban no cambia.
+        /// </summary>
+        private static object? NormalizeAttributeValue(object? value)
+        {
+            if (value == null)
+            {
+                return null;
+            }
+
+            var type = value.GetType();
+            if (type.IsPrimitive || type.IsEnum
+                || value is string || value is decimal
+                || value is DateTime || value is DateTimeOffset
+                || value is TimeSpan || value is Guid)
+            {
+                return value;
+            }
+
+            return value.ToString();
+        }
+
