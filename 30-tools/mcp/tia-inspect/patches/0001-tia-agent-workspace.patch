+                {
+                    var data = document.RootElement;
+                    if (!data.TryGetProperty("schemaVersion", out var schemaVersion) || schemaVersion.GetInt32() != 1) return false;
+                    if (!data.TryGetProperty("disposable", out var disposable) || disposable.ValueKind != JsonValueKind.True) return false;
+                    if (!data.TryGetProperty("projectPath", out var projectPath) || projectPath.ValueKind != JsonValueKind.String) return false;
+                    if (!data.TryGetProperty("backupProjectPath", out var backupProjectPath) || backupProjectPath.ValueKind != JsonValueKind.String) return false;
