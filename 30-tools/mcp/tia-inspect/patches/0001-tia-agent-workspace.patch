+    /// on McpServer and therefore visible in read mode. They are registered only with the
+    /// --allow-write tool type now.
+    /// </summary>
+    public static partial class McpServerWrite
+    {
+        // Deliberately not registered as an MCP tool. The incoming SimaticML can contain an
+        // F-block and Openness supports F-block import, so no destination-only preflight is enough.
+        public static ResponseImportBlock ImportBlock(
+            [Description("softwarePath: defines the path in the project structure to the PLC software")] string softwarePath,
+            [Description("groupPath: defines the path in the project structure to the group, where to import the block")] string groupPath,
+            [Description("importPath: defines the path of the XML file from which to import the block")] string importPath)
+        {
+            return Guarded(nameof(ImportBlock), () =>
+            {
+                if (!Portal.ImportBlock(softwarePath, groupPath, importPath))
+                {
+                    throw new McpException($"Failed importing block from '{importPath}' to '{groupPath}'");
+                }
+
+                return new ResponseImportBlock
+                {
+                    Message = $"Block imported from '{importPath}' to '{groupPath}'. {SaveHint}",
+                    Meta = OkMeta()
+                };
+            });
+        }
+
+        // Unregistered until XML input can be proven not to create or replace an F-compliant PLC data type.
+        public static ResponseImportType ImportType(
+            [Description("softwarePath: defines the path in the project structure to the PLC software")] string softwarePath,
+            [Description("groupPath: defines the path in the project structure to the group, where to import the type")] string groupPath,
+            [Description("importPath: defines the path of the XML file from which to import the type")] string importPath)
+        {
+            return Guarded(nameof(ImportType), () =>
+            {
+                if (!Portal.ImportType(softwarePath, groupPath, importPath))
+                {
+                    throw new McpException($"Failed importing type from '{importPath}' to '{groupPath}'");
+                }
+
+                return new ResponseImportType
+                {
+                    Message = $"Type imported from '{importPath}' to '{groupPath}'. {SaveHint}",
+                    Meta = OkMeta()
+                };
+            });
+        }
+
+#if TIA_V20_PLUS
+        // SIMATIC Source Documents: la API no existe antes de Openness V20.
+        // Ver 00-meta/07-viabilidad-openness-v15-v18.md.
+
+        // Deliberately not registered until every incoming document and collision is classified.
+        public static ResponseImportFromDocuments ImportFromDocuments(
+            [Description("softwarePath: defines the path in the project structure to the PLC software")] string softwarePath,
+            [Description("groupPath: optional path within the PLC program where the block should be placed (empty for root)")] string groupPath,
+            [Description("importPath: directory containing the document files (.s7dcl/.s7res)")] string importPath,
+            [Description("fileNameWithoutExtension: name of the block file without extension")] string fileNameWithoutExtension,
+            [Description("importOption: ImportDocumentOptions value (None, Override, SkipInactiveCultures, ActivateInactiveCultures)")] string importOption = "Override")
+        {
+            return Guarded(nameof(ImportFromDocuments), () =>
+            {
+                if (Engineering.TiaMajorVersion < 20)
+                {
+                    throw new McpException("ImportFromDocuments requires TIA Portal V20 or newer");
+                }
+
+                var option = McpServer.ParseImportDocumentOption(importOption);
+                var warnings = new JsonArray();
+                try
+                {
+                    var missingIds = McpServer.GetResMissingEnUsIds(importPath, fileNameWithoutExtension);
+                    if (missingIds != null && missingIds.Count > 0)
+                    {
+                        warnings.Add(new JsonObject
+                        {
+                            ["name"] = fileNameWithoutExtension,
+                            ["missingEnUsIds"] = new JsonArray(missingIds.Select(id => (JsonNode)id).ToArray())
+                        });
+                    }
+                }
+                catch (Exception ex)
+                {
+                    McpServer.Logger?.LogDebug(ex, "Failed to evaluate .s7res warnings");
+                }
+
+                if (!Portal.ImportFromDocuments(softwarePath, groupPath, importPath, fileNameWithoutExtension, option))
+                {
+                    throw new McpException($"Failed importing '{fileNameWithoutExtension}' from '{importPath}'");
+                }
+
+                var meta = OkMeta();
+                meta["warnings"] = warnings;
+                return new ResponseImportFromDocuments
+                {
+                    Message = $"Imported '{fileNameWithoutExtension}' from '{importPath}'. {SaveHint}",
+                    Meta = meta
+                };
+            });
+        }
+
+        // Deliberately not registered until the full batch and all collisions are classified.
+        public static Task<ResponseImportBlocksFromDocuments> ImportBlocksFromDocuments(
+            IProgress<ProgressNotificationValue> progress,
+            [Description("softwarePath: defines the path in the project structure to the PLC software")] string softwarePath,
+            [Description("groupPath: optional path within the PLC program where the blocks should be placed (empty for root)")] string groupPath,
+            [Description("importPath: directory containing the document files (.s7dcl/.s7res)")] string importPath,
+            [Description("regexName: name or regular expression to select block files (empty for all)")] string regexName = "",
+            [Description("importOption: ImportDocumentOptions value (None, Override, SkipInactiveCultures, ActivateInactiveCultures)")] string importOption = "Override")
+        {
+            var response = Guarded(nameof(ImportBlocksFromDocuments), () =>
+            {
+                if (Engineering.TiaMajorVersion < 20)
+                {
+                    throw new McpException("ImportBlocksFromDocuments requires TIA Portal V20 or newer");
+                }
+
+                var option = McpServer.ParseImportDocumentOption(importOption);
+                var scanWarnings = new JsonArray();
+                var matchingNames = new List<string>();
+                if (Directory.Exists(importPath))
+                {
+                    var rx = string.IsNullOrWhiteSpace(regexName) ? null : new Regex(regexName, RegexOptions.Compiled);
+                    foreach (var file in Directory.GetFiles(importPath, "*.s7dcl", SearchOption.TopDirectoryOnly))
+                    {
+                        var name = Path.GetFileNameWithoutExtension(file);
+                        if (rx != null && !rx.IsMatch(name)) continue;
+                        matchingNames.Add(name);
+                        try
+                        {
+                            var missingIds = McpServer.GetResMissingEnUsIds(importPath, name);
+                            if (missingIds != null && missingIds.Count > 0)
+                            {
+                                scanWarnings.Add(new JsonObject
+                                {
+                                    ["name"] = name,
+                                    ["missingEnUsIds"] = new JsonArray(missingIds.Select(id => (JsonNode)id).ToArray())
+                                });
+                            }
+                        }
+                        catch (Exception ex)
+                        {
+                            McpServer.Logger?.LogDebug(ex, "Failed to evaluate .s7res warnings for {BlockName}", name);
+                        }
+                    }
+                }
+
+                progress.Report(new ProgressNotificationValue
+                {
+                    Progress = 0,
+                    Total = matchingNames.Count,
+                    Message = matchingNames.Count > 0 ? $"Starting import of {matchingNames.Count} blocks from documents..." : "Scanning import directory..."
+                });
+
+                var imported = Portal.ImportBlocksFromDocuments(softwarePath, groupPath, importPath, regexName, option);
+                var items = new List<ResponseBlockInfo>();
+                var importedBlocks = imported == null ? Enumerable.Empty<PlcBlock>() : imported;
+                foreach (var block in importedBlocks)
+                {
+                    if (block == null) continue;
+                    items.Add(new ResponseBlockInfo
+                    {
+                        Path = Portal.GetBlockPath(block),
+                        Name = block.Name,
+                        TypeName = block.GetType().Name,
+                        Namespace = block.Namespace,
+                        ProgrammingLanguage = Enum.GetName(typeof(ProgrammingLanguage), block.ProgrammingLanguage),
+                        IsFailsafe = McpServer.GetFailsafeClassification(block),
+                        MemoryLayout = Enum.GetName(typeof(MemoryLayout), block.MemoryLayout),
+                        IsConsistent = block.IsConsistent,
+                        HeaderName = block.HeaderName,
+                        ModifiedDate = block.ModifiedDate,
+                        IsKnowHowProtected = block.IsKnowHowProtected,
+                        Attributes = Helper.GetAttributeList(block),
+                        Description = block.ToString()
+                    });
+                }
+
+                progress.Report(new ProgressNotificationValue
+                {
+                    Progress = items.Count,
+                    Total = matchingNames.Count,
+                    Message = $"Document import completed: {items.Count} blocks imported successfully"
+                });
+
+                var meta = OkMeta();
+                meta["totalBlocks"] = matchingNames.Count;
+                meta["importedBlocks"] = items.Count;
+                meta["warnings"] = scanWarnings;
+                return new ResponseImportBlocksFromDocuments
+                {
+                    Message = $"Document import completed: {items.Count} blocks imported from '{importPath}'. {SaveHint}",
+                    Items = items,
+                    Meta = meta
+                };
+            });
+
+            return Task.FromResult(response);
+        }
+#endif // TIA_V20_PLUS
+
+        [McpServerTool(Name = "SaveProject", Title = "Save project", Destructive = true, Idempotent = true, OpenWorld = false, UseStructuredContent = true),
+         Description("Save the current TIA Portal local project/session; available only in --allow-write mode")]
+        public static ResponseSaveProject SaveProject()
+        {
+            return Guarded(nameof(SaveProject), () =>
+            {
+                if (!Portal.IsLocalSession && Portal.SaveProject())
+                {
+                    return new ResponseSaveProject { Message = "Local project saved", Meta = OkMeta() };
+                }
+                if (Portal.IsLocalSession && Portal.SaveSession())
+                {
+                    return new ResponseSaveProject { Message = "Local session saved", Meta = OkMeta() };
+                }
+
+                throw new McpException("Failed to save the current project/session");
+            });
+        }
+
+        // Unregistered: SaveAsProject can write outside the fixture root; SaveProject is sufficient
+        // for the current disposable-fixture acceptance workflow.
+        public static ResponseSaveAsProject SaveAsProject(
+            [Description("newProjectPath: defines the new path where to save the project")] string newProjectPath)
+        {
+            return Guarded(nameof(SaveAsProject), () =>
+            {
+                if (Portal.IsLocalSession)
+                {
+                    throw new McpException($"Cannot save local session as '{newProjectPath}'");
+                }
+                if (!Portal.SaveAsProject(newProjectPath))
+                {
+                    throw new McpException($"Failed saving local project as '{newProjectPath}'");
+                }
+
+                return new ResponseSaveAsProject
+                {
+                    Message = $"Local project saved as '{newProjectPath}'",
+                    Meta = OkMeta()
+                };
+            });
+        }
+    }
+}
