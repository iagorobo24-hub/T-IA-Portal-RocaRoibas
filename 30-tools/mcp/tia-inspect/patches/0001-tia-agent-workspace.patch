diff --git a/src/TiaMcpServer/Siemens/SafetyClassification.cs b/src/TiaMcpServer/Siemens/SafetyClassification.cs
new file mode 100644
index 0000000..d6d61c8
--- /dev/null
+++ b/src/TiaMcpServer/Siemens/SafetyClassification.cs
@@ -0,0 +1,31 @@
+using Siemens.Engineering.Safety;
+using Siemens.Engineering.SW.Blocks;
+using System;
+
+namespace TiaMcpServer.Siemens
+{
+    /// <summary>
+    /// Fail-closed classification shared by read responses and every project write preflight.
+    /// A null result means the API did not provide enough evidence to permit a write.
+    /// </summary>
+    public static class SafetyClassification
+    {
+        public static bool? GetFailsafeClassification(PlcBlock block)
+        {
+            if (block == null) return null;
+
+            var language = Enum.GetName(typeof(ProgrammingLanguage), block.ProgrammingLanguage);
+            if (string.IsNullOrWhiteSpace(language) || language == "Undef") return null;
+            if (language.StartsWith("F_", StringComparison.Ordinal)) return true;
+
+            try
+            {
+                return block.GetService<SafetySignatureProvider>() != null;
+            }
+            catch (Exception)
+            {
+                return null;
+            }
+        }
+    }
+}
