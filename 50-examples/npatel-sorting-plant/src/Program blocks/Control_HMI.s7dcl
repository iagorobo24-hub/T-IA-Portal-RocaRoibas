        {
           S7_Optimized := "TRUE";
           S7_StandardRetain := "FALSE"
        }
    DATA_BLOCK Control_HMI
        VAR RETAIN
            toHMI : STRUCT
                resetStatus : Bool;
                numWorkpieces : USInt;
                numCylinders : USInt;
                numCubes : USInt;
                Error : Bool;
                ErrorID : Word;
            END_STRUCT;
            fromHMI : STRUCT
                resetSimulation : Bool;
                generateWorkpieces : Bool;
                cylinderCommand : STRUCT
                    extendCylinder : Bool;
                    retractCylinder : Bool;
                END_STRUCT;
                shortConveyor : STRUCT
                    constSpeedControl : Bool;
                    varSpeedControl : Bool;
                    varSpeedPercentage : Real;
                END_STRUCT;
                longConveyor : STRUCT
                    constSpeedControl : Bool;
                    varSpeedControl : Bool;
                    varSpeedPercentage : Real;
                END_STRUCT;
            END_STRUCT;
        END_VAR
    END_DATA_BLOCK
