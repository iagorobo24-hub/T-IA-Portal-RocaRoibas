  <SW.Types.PlcStruct ID="0">
    <AttributeList>
      <Interface><Sections xmlns="http://www.siemens.com/automation/Openness/SW/Interface/v5">
  <Section Name="None">
    <Member Name="useQdn" Datatype="Bool">
      <Comment>
        <MultiLanguageText Lang="en-US">When TRUE, configure the connection for TCP over the fully qualified domain name</MultiLanguageText>
      </Comment>
    </Member>
    <Member Name="hwIdentifier" Datatype="HW_ANY">
      <Comment>
        <MultiLanguageText Lang="en-US">HW_ID of the PROFINET interface of the CPU</MultiLanguageText>
      </Comment>
    </Member>
    <Member Name="connectionID" Datatype="CONN_OUC">
      <Comment>
        <MultiLanguageText Lang="en-US">ID of the TCP connection </MultiLanguageText>
      </Comment>
    </Member>
    <Member Name="qdnAdressBroker" Datatype="String[254]">
      <Comment>
        <MultiLanguageText Lang="en-US">URL of the MQTT Broker . Must end with a dot (".")</MultiLanguageText>
      </Comment>
    </Member>
    <Member Name="ipAdressBroker" Datatype="Array[0..3] of USInt">
      <Comment>
        <MultiLanguageText Lang="en-US">IP Address of the broker, e.g.: for the address "192.168.0.10" </MultiLanguageText>
      </Comment>
      <Subelement Path="0">
        <Comment>
          <MultiLanguageText Lang="en-US">"192"</MultiLanguageText>
        </Comment>
      </Subelement>
      <Subelement Path="1">
        <Comment>
          <MultiLanguageText Lang="en-US">"168"</MultiLanguageText>
        </Comment>
      </Subelement>
      <Subelement Path="2">
        <Comment>
          <MultiLanguageText Lang="en-US">"0"</MultiLanguageText>
        </Comment>
      </Subelement>
      <Subelement Path="3">
        <Comment>
          <MultiLanguageText Lang="en-US">"10"</MultiLanguageText>
        </Comment>
      </Subelement>
    </Member>
    <Member Name="localPort" Datatype="UInt">
      <Comment>
        <MultiLanguageText Lang="en-US">Local port number of the CPU</MultiLanguageText>
      </Comment>
      <StartValue>0</StartValue>
    </Member>
    <Member Name="mqttPort" Datatype="UInt">
      <Comment>
        <MultiLanguageText Lang="en-US">Remote port of the MQTT broker </MultiLanguageText>
      </Comment>
      <StartValue>1884</StartValue>
    </Member>
    <Member Name="activateSecureConn" Datatype="Bool">
      <Comment>
        <MultiLanguageText Lang="en-US">When TRUE, the communication is secured via TLS</MultiLanguageText>
      </Comment>
    </Member>
    <Member Name="validateSubjectAlternateNameOfServer" Datatype="Bool">
      <Comment>
        <MultiLanguageText Lang="en-US">Only for the client side. When TRUE, the IP address / QDN of the Broker is validated against the certificates SAN when the connection is established.</MultiLanguageText>
      </Comment>
    </Member>
    <Member Name="idTlsServerCertificate" Datatype="UDInt">
      <Comment>
        <MultiLanguageText Lang="en-US">Identifier of X.509 certificate (usually a CA certificate) to validate the authetication of the TLS server. Only relevant, if "activateSecureConn" is "true"</MultiLanguageText>
      </Comment>
    </Member>
    <Member Name="idTlsOwnCertificate" Datatype="UDInt">
      <Comment>
        <MultiLanguageText Lang="en-US">Identifier of own X.509 certificate to validate the own authetication against the TLS server. Only relevant, if "activateSecureConn" is "true" and the TLS server requests a client authentication </MultiLanguageText>
      </Comment>
    </Member>
  </Section>
