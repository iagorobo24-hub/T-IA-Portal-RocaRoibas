FUNCTION_BLOCK "FB_AgentDemo"
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
AUTHOR : TIA_Claude
FAMILY : Demo
// Bloque mínimo de aceptación para comprobar el servidor tia-create.
// La lógica es deliberadamente simple: publica el estado de Enable.
   VAR_INPUT
      Enable : Bool;
   END_VAR

   VAR_OUTPUT
      Active : Bool;
   END_VAR

BEGIN
   #Active := #Enable;
END_FUNCTION_BLOCK
